{
  "name": "@7ka/eslint-config",
  "version": "0.1.4",
  "description": "Strict ESLint flat config for TypeScript + React + FSD projects",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./fsd-strict": {
      "types": "./fsd-strict.d.ts",
      "default": "./fsd-strict.js"
    },
    "./fsd-light": {
      "types": "./fsd-light.d.ts",
      "default": "./fsd-light.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "fsd-strict.js",
    "fsd-strict.d.ts",
    "fsd-light.js",
    "fsd-light.d.ts"
  ],
  "types": "index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "eslint",
    "eslint-config",
    "typescript",
    "react",
    "fsd",
    "feature-sliced"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/7ka-dev/tooling",
    "directory": "packages/eslint-config"
  },
  "homepage": "https://github.com/7ka-dev/tooling/tree/master/packages/eslint-config",
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "typescript-eslint": ">=8.0.0",
    "eslint-plugin-react-hooks": ">=5.0.0",
    "eslint-plugin-react-refresh": ">=0.4.0",
    "eslint-plugin-import": ">=2.0.0",
    "eslint-plugin-unicorn": ">=55.0.0",
    "eslint-plugin-boundaries": ">=4.0.0"
  }
}
